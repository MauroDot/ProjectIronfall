# Normalize text in Git and use LF in working trees by default.
* text=auto eol=lf

# Unreal packages are binary Git LFS payloads.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Explicit source and configuration policy.
*.cpp      text eol=lf
*.h        text eol=lf
*.cs       text eol=lf
*.ini      text eol=lf
*.uproject text eol=lf
*.uplugin  text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.md       text eol=lf
*.xml      text eol=lf
*.proj     text eol=lf
*.config   text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.ps1      text eol=lf
*.sh       text eol=lf

# Windows command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Observed/nontext resource formats.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
